# MDSync - Centralizador de Dados Geotécnicos
# Modelo de variáveis de ambiente para desenvolvimento e produção
# AVISO: Nunca insira chaves reais neste arquivo. Copie para .env.local se necessário.

# URL pública do Geotinho hospedado no Cloudflare Workers.
# Cadastre GEMINI_API_KEY como Worker Secret; não use VITE_* para chaves.
VITE_ARGON_CHAT_URL=https://mdsync---mining-geotechnical-data.maycondouglasreymont.workers.dev

# Integração com API Corporativa / Fluig / PCMI (Opcional)
VITE_COMPANY_API_URL=
VITE_COMPANY_API_KEY=

# PostHog browser analytics (optional outside production)
VITE_POSTHOG_KEY=phc_your_project_token
VITE_POSTHOG_HOST=https://us.i.posthog.com

# PostHog AI Observability for the Cloudflare Worker. Configure these as
# Worker secrets in deployed environments; never expose them with a VITE_ prefix.
POSTHOG_KEY=
POSTHOG_HOST=

