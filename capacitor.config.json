{
  "appId": "com.itaminas.mdsync",
  "appName": "MDSync Geotecnia",
  "webDir": "dist",
  "server": {
    "androidScheme": "https",
    "iosScheme": "https"
  },
  "android": {
    "allowMixedContent": true,
    "captureInput": true,
    "webContentsDebuggingEnabled": false,
    "backgroundColor": "#0d1b2a"
  },
  "ios": {
    "preferredContentMode": "mobile",
    "limitsNavigationsToAppBoundDomains": false,
    "contentInset": "always",
    "backgroundColor": "#0d1b2a"
  }
}
